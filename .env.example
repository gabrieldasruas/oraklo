# Copie para .env.local e preencha. Nunca commite o .env.local.
# Valores em Supabase → Project Settings → API / Database.

# URL do projeto (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública, segura no navegador (Project Settings → API → anon / publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço: ignora o RLS. Só no servidor e no worker, nunca com prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Conexão direta ao Postgres, usada pelas migrations e pelo script de importação
# (Project Settings → Database → Connection string → URI; troque [YOUR-PASSWORD] pela senha do banco)
DATABASE_URL=

# ---------- Recursos opcionais (sem a variável, a tela mostra um aviso de configuração) ----------

# Envio de e-mail (https://resend.com): chave e remetente com domínio verificado, ex.: "Oraklo <contato@seudominio.com.br>"
RESEND_API_KEY=
EMAIL_FROM=
# Segredo do webhook da Resend (aberturas e cliques): Resend → Webhooks → /api/webhooks/resend
RESEND_WEBHOOK_SECRET=
# Protege o cron diário (follow-ups e resumo do radar). Qualquer texto longo e aleatório
CRON_SECRET=
# Assina os links de descadastro dos e-mails (se vazio, usa a chave de serviço)
UNSUBSCRIBE_SECRET=

# Escrita com IA (Claude): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Decisores pelo domínio da empresa (https://hunter.io)
HUNTER_API_KEY=

# Domínio público usado nos links dos e-mails (padrão: domínio de produção da Vercel)
NEXT_PUBLIC_APP_URL=

# Cifra tokens de integração (RD Station). Se vazio, usa UNSUBSCRIBE_SECRET ou a chave de serviço
CRM_SECRET=
